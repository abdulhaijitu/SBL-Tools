{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
        "dev:web": "vite",
        "dev:api": "npx wrangler dev --port 8787",
        "typecheck": "tsc --noEmit",
        "build": "vite build",
        "deploy": "wrangler deploy",
        "db:generate": "drizzle-kit generate",
        "db:migrate:local": "wrangler d1 migrations apply sbl-database --local",
        "db:migrate:remote": "wrangler d1 migrations apply sbl-database --remote",
        "db:seed:local": "wrangler d1 execute sbl-database --local --file=scripts/seed-d1.sql",
        "db:seed:remote": "wrangler d1 execute sbl-database --remote --file=scripts/seed-d1.sql",
        "db:studio": "drizzle-kit studio"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260914.1",
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "drizzle-kit": "^0.31.10",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vite": "^7.0.7",
        "wrangler": "^4.131.2"
    },
    "dependencies": {
        "@alpinejs/collapse": "^3.17.2",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.13.7",
        "lucide-react": "^1.46.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "sortablejs": "^1.15.7"
    }
}
