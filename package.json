{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "live": "wrangler dev --remote",
        "live:build": "php render_pages.php && node build_worker.cjs && wrangler dev --remote",
        "serve": "php artisan serve",
        "build": "vite build",
        "build:worker": "node build_worker.cjs",
        "deploy": "php render_pages.php && node build_worker.cjs && wrangler deploy"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "sortablejs": "^1.15.7"
    }
}
